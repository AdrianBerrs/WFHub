{
  "productName": "WFHub",
  "version": "0.1.0",
  "identifier": "com.wfhub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "WFHub",
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "width": 900,
        "height": 600,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "",
        "width": 420,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../scripts/ocr/ocr_vision.py",
      "../scripts/ocr/ocr_vision_build.py"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
