{
  "productName": "WFHub",
  "version": "0.1.0",
  "identifier": "com.wfhub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "WFHub",
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "width": 900,
        "height": 600,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "",
        "width": 964,
        "height": 310,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../scripts": "scripts",
      "../update.sh": "update.sh",
      "../update_prices.sh": "update_prices.sh",
      "../python": "python",
      "../data/items_list.json": "data/items_list.json",
      "../data/mods_all.json": "data/mods_all.json",
      "../data/prices.json": "data/prices.json",
      "../data/modLocations.json": "data/modLocations.json",
      "../data/enemyModTables.json": "data/enemyModTables.json",
      "../data/enemyLocations.json": "data/enemyLocations.json",
      "../data/missionRewards.json": "data/missionRewards.json",
      "../data/cetusBountyRewards.json": "data/cetusBountyRewards.json",
      "../data/solarisBountyRewards.json": "data/solarisBountyRewards.json",
      "../data/zarimanRewards.json": "data/zarimanRewards.json",
      "../data/transientRewards.json": "data/transientRewards.json",
      "../data/relics.json": "data/relics.json",
      "../data/prime_parts.json": "data/prime_parts.json",
      "../data/rivenStats.json": "data/rivenStats.json",
      "../data/rivenWeaponRules.json": "data/rivenWeaponRules.json",
      "../data/filtered_items.json": "data/filtered_items.json",
      "../data/misc_wfcd.json": "data/misc_wfcd.json",
      "../data/resources_wfcd.json": "data/resources_wfcd.json",
      "../data/dict.en.json": "data/dict.en.json",
      "../data/arcanes_all.json": "data/arcanes_all.json",
      "../data/mod_ranks.json": "data/mod_ranks.json",
      "../data/ducat_values.json": "data/ducat_values.json",
      "../data/items_prices.json": "data/items_prices.json",
      "../data/circuit_images.json": "data/circuit_images.json",
      "../data/prime_vault.json": "data/prime_vault.json",
      "../data/mod_meta.json": "data/mod_meta.json",
      "../data/mod_images.json": "data/mod_images.json",
      "../data/arcane_images.json": "data/arcane_images.json",
      "../data/ExportBoosterPacks.json": "data/ExportBoosterPacks.json",
      "../data/ExportBundles.json": "data/ExportBundles.json",
      "../data/ExportCustoms.json": "data/ExportCustoms.json",
      "../data/ExportFlavour.json": "data/ExportFlavour.json",
      "../data/ExportRelics.json": "data/ExportRelics.json",
      "../data/ExportResources.json": "data/ExportResources.json",
      "../data/ExportUpgrades.json": "data/ExportUpgrades.json",
      "../data/ExportWeapons.json": "data/ExportWeapons.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
